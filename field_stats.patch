diff --git a/server/src/main/java/org/opensearch/index/mapper/MapperService.java b/server/src/main/java/org/opensearch/index/mapper/MapperService.java
index 0000000..1111111 100644
--- a/server/src/main/java/org/opensearch/index/mapper/MapperService.java
+++ b/server/src/main/java/org/opensearch/index/mapper/MapperService.java
@@
+    // --- Field stats cache ---
+    private volatile int cachedFieldCount = -1;

@@
+    public int getFieldCount() {
+        int local = cachedFieldCount;
+        if (local != -1) {
+            return local;
+        }
+
+        synchronized (this) {
+            if (cachedFieldCount == -1) {
+                cachedFieldCount = computeFieldCount();
+            }
+            return cachedFieldCount;
+        }
+    }
+
+    private int computeFieldCount() {
+        DocumentMapper docMapper = documentMapper();
+        if (docMapper == null) return 0;
+
+        int count = 0;
+        for (Mapper mapper : docMapper.mappers()) {
+            count += FieldCountHelper.countFields(mapper);
+        }
+        return count;
+    }

@@
+    // Invalidate cache on mapping update
+    cachedFieldCount = -1;


diff --git a/server/src/main/java/org/opensearch/index/IndexService.java b/server/src/main/java/org/opensearch/index/IndexService.java
index 0000000..1111111 100644
--- a/server/src/main/java/org/opensearch/index/IndexService.java
+++ b/server/src/main/java/org/opensearch/index/IndexService.java
@@
+    public FieldStats getFieldStats() {
+        MapperService mapperService = mapperService();
+
+        int fieldCount = mapperService.getFieldCount();
+
+        int fieldLimit = indexSettings()
+            .getValue("index.mapping.total_fields.limit");
+
+        return new FieldStats(fieldCount, fieldLimit);
+    }


